@echo off
chcp 65001 >nul
title ЗАБЕГ.РФ 2027 - ДОСТУП В ИНТЕРНЕТ (Cloudflare Tunnel)
color 0b

echo ===============================================================================
echo   ВСЕРОССИЙСКИЙ ПОЛУМАРАФОН «ЗАБЕГ.РФ — КАМЧАТКА 2027»
echo   ЗАПУСК ИНТЕРАКТИВНОЙ ПЛАТФОРМЫ С ДОСТУПОМ В ИНТЕРНЕТ
echo ===============================================================================
echo.
echo [1/2] Запуск локального веб-сервера на порту 8765...
start /B python -m http.server 8765 >nul 2>&1

echo [2/2] Подключение защищенного туннеля в интернет (Cloudflare Tunnel)...
echo.
echo ===============================================================================
echo   ВНИМАНИЕ! ССЫЛКА ДЛЯ ВХОДА ЧЕРЕЗ ИНТЕРНЕТ ПОЯВИТСЯ НИЖЕ (https://...trycloudflare.com)
echo   Скопируйте ее и отправьте Министру, спонсорам или откройте на смартфоне:
echo ===============================================================================
echo.

"C:\Program Files (x86)\cloudflared\cloudflared.exe" tunnel --url http://127.0.0.1:8765

echo.
echo Сервер остановлен.
pause
